# Copy to .env.local (git-ignored). Used by the live demo's fault alert -> e-mail to a team phone.
# Gmail example: smtp.gmail.com / 587 / an App Password (not your real password).
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_FROM=
ALERT_TO=

# Technician contact for the alert banner (browser-visible: Vite exposes VITE_* to the client). Leave empty to disable the buttons.
VITE_TECH_PHONE=
VITE_TECH_EMAIL=
